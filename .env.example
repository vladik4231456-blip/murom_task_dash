# Local development / hosting environment settings.
# Never commit the real .env file.
ADMIN_EMAIL=your-real-email@example.com
ADMIN_PASSWORD=use-a-long-unique-password
JWT_SECRET=generate-a-long-random-secret
FLASK_ENV=development
FLASK_DEBUG=0
SEED_DEMO_DATA=1
PORT=3000
# Leave empty locally to use app.sqlite. Set the Neon PostgreSQL URL on hosting.
DATABASE_URL=
# Optional: comma-separated allowed browser origins when using a separate frontend.
CORS_ORIGINS=

# Real email verification settings (free tiers work via Gmail, Mailgun, Resend, SMTP relay).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=1
